# ec20-voice-steer settings. Copy to .env and fill in. .env is gitignored; never commit a real camera address.
# The bench EC20 only. Every ec20-steer command except --help sends VISCA over IP to this address.
EC20_STEER_IP=
# The EC20's VISCA over IP port is 52381 and can't be changed. Override only for a test listener.
EC20_STEER_PORT=52381
# Seconds to wait for a VISCA reply.
EC20_STEER_TIMEOUT_S=1.0
